{
  "name": "backend-mastery",
  "version": "1.0.0",
  "description": "A hands-on backend engineering curriculum: beginner to senior level. TypeScript + NestJS + PostgreSQL track.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "embedded-postgres"
    ]
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:topic": "node scripts/run-topic.mjs",
    "test:solutions": "SOLUTION_MODE=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@swc/core": "^1.16.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.0",
    "aws-sdk-client-mock": "^4.1.0",
    "bullmq": "^6.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.9.0",
    "express": "^5.1.0",
    "globals": "^17.11.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.3.0",
    "msw": "^2.7.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "redis-memory-server": "^0.17.1",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
