# Copy to .env. Every value has a dev-friendly default; the app boots fine
# with no env at all (in-memory store, "dev-secret" signing key).

# HMAC secret for auth tokens. NEVER ship the default beyond local dev:
# anyone holding it can mint tokens for any user.
TOKEN_SECRET=dev-secret

# HTTP + websocket port.
PORT=3003

# pino log level (error|warn|info|debug|trace).
LOG_LEVEL=info

# How often the presence sweeper reaps stale heartbeats (ms).
SWEEP_INTERVAL_MS=15000

# Set to switch MessageStore from in-memory to the Postgres adapter.
# Schema: docker compose up -d db applies db/migrations on first init.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat
