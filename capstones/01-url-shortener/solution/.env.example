# Copy to .env for the production-adapters mode. With neither URL set the app
# boots fully in-memory (zero external services) - that is the default wiring.
PORT=3001
LOG_LEVEL=info

# Postgres: links + click events. Migrations in db/migrations run via psql.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener

# Redis: cache-aside + BullMQ click queue. Same URL feeds both.
REDIS_URL=redis://localhost:6379
