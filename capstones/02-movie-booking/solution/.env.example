# Port the HTTP server binds to.
PORT=3002

# How long a seat hold stays ACTIVE before it expires (ms). Default 600000 = 10 min.
HOLD_TTL_MS=600000

# How often the background sweep flips past-due ACTIVE holds to EXPIRED (ms).
SWEEP_INTERVAL_MS=60000

# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info

# When set, the app uses the real PostgreSQL adapter instead of the in-memory one.
# Zero-config demo/tests leave this unset and run entirely in memory.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/movie_booking
